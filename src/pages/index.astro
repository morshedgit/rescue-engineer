---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProblemBreakdown from '../components/ProblemBreakdown.astro';
import Process from '../components/Process.astro';
import CodeTeardown from '../components/CodeTeardown.astro';
import Pricing from '../components/Pricing.astro';
import TechStack from '../components/TechStack.astro';
import IntakeSection from '../components/IntakeSection.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Vibe Code Rescue | Turn AI Prototypes into Secure Production Software"
  description="Hit a wall with Lovable, Bolt, Cursor, or Replit? Senior fractional engineering to resolve security, database, auth, and deployment vulnerabilities in your AI-built apps."
>
  <!-- Navigation Header -->
  <Navbar />

  <!-- Main Content Sections -->
  <main id="main-content">
    <Hero />
    <ProblemBreakdown />
    <Process />
    <CodeTeardown />
    <Pricing />
    <TechStack />
    <IntakeSection />
    <FAQ />
  </main>

  <!-- Global Footer -->
  <Footer />
</Layout>
