---
const teardowns = [
  {
    id: 'teardown-rls',
    title: '1. Supabase / Postgres RLS Bypass',
    shortTitle: 'Supabase RLS Data Leak',
    riskLevel: 'Critical Security Breach',
    context: 'AI coding tools frequently generate queries that work on localhost using the admin service_role key, or fail to enable PostgreSQL Row Level Security (RLS). This allows any visitor to query the entire database directly.',
    vibeCode: `-- Flawed AI Schema (Public Read/Write by Default)
CREATE TABLE customer_orders (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID REFERENCES auth.users(id),
  total_amount NUMERIC,
  customer_ssn_or_tax_id TEXT,
  created_at TIMESTAMPTZ DEFAULT now()
);

-- RLS is NOT enabled! 
-- Anyone with the public anon key can run:
-- SELECT * FROM customer_orders; and steal all customer records.`,
    rescueCode: `-- Production Hardening: Zero-Trust RLS Policies
ALTER TABLE customer_orders ENABLE ROW LEVEL SECURITY;

-- 1. Restrict users to ONLY see their own data
CREATE POLICY "Users can only select own orders"
  ON customer_orders
  FOR SELECT
  TO authenticated
  USING (auth.uid() = user_id);

-- 2. Prevent arbitrary client-side writes / modifications
CREATE POLICY "Users can insert own orders"
  ON customer_orders
  FOR INSERT
  TO authenticated
  WITH CHECK (auth.uid() = user_id);`,
    fixImpact: 'Closed database breach: 100% of customer orders and sensitive tax IDs are now shielded behind cryptographically signed JWT user claims.'
  },
  {
    id: 'teardown-stripe',
    title: '2. Stripe Webhook Race Condition',
    shortTitle: 'Broken Stripe Webhook',
    riskLevel: 'Lost Revenue & Duplicates',
    context: 'AI generates standard webhook receivers that parse raw JSON without verifying the cryptographic signature, causing security vulnerabilities and duplicate billing loops during network retries.',
    vibeCode: `// Flawed AI Webhook Handler
export async function POST(req: Request) {
  const body = await req.json();
  
  // Vulnerability: No signature verification!
  // Anyone can POST fake 'checkout.session.completed' events!
  if (body.type === 'checkout.session.completed') {
    await db.user.update({
      where: { id: body.data.object.client_reference_id },
      data: { isSubscribed: true }
    });
  }
  return Response.json({ received: true });
}`,
    rescueCode: `// Production Rescue: Cryptographic Verification + Idempotency
export async function POST(req: Request) {
  const payload = await req.text();
  const sig = req.headers.get('stripe-signature')!;
  
  // 1. Verify cryptographic signature from Stripe webhook secret
  const event = stripe.webhooks.constructEvent(payload, sig, process.env.STRIPE_WEBHOOK_SECRET!);
  
  // 2. Transactional Idempotency check to prevent duplicate execution
  await prisma.$transaction(async (tx) => {
    const existing = await tx.processedEvent.findUnique({ where: { eventId: event.id } });
    if (existing) return; // Already processed
    
    if (event.type === 'checkout.session.completed') {
      await handleSubscriptionActivation(tx, event.data.object);
      await tx.processedEvent.create({ data: { eventId: event.id } });
    }
  });
  
  return new Response('OK', { status: 200 });
}`,
    fixImpact: 'Zero unauthorized activations, immune to replay attacks, and 100% reliable subscription status syncing even across network timeouts.'
  },
  {
    id: 'teardown-secrets',
    title: '3. Client-Side Leaked API Keys',
    shortTitle: 'Leaked OpenAI / API Keys',
    riskLevel: 'Wallet Drain & Key Theft',
    context: 'AI prototypes commonly prefix OpenAI, Anthropic, or database credentials with NEXT_PUBLIC_ or VITE_, compiling private secrets directly into client browser bundles.',
    vibeCode: `// Flawed AI Code: Frontend calling AI directly
import OpenAI from 'openai';

// Critical Bug: NEXT_PUBLIC exposes this key to all visitors in DevTools!
const openai = new OpenAI({
  apiKey: process.env.NEXT_PUBLIC_OPENAI_API_KEY,
  dangerouslyAllowBrowser: true // AI added this to silence the error!
});

export const generateContent = (prompt: string) => {
  return openai.chat.completions.create({ ... });
};`,
    rescueCode: `// Production Rescue: Server-side Protected Edge Proxy with Rate Limiting
import { Ratelimit } from '@upstash/ratelimit';
import { Redis } from '@upstash/redis';

// Key is strictly server-side (never prefixed with NEXT_PUBLIC)
const openai = new OpenAI({ apiKey: process.env.OPENAI_API_KEY });
const ratelimit = new Ratelimit({ redis: Redis.fromEnv(), limiter: Ratelimit.slidingWindow(20, '1 m') });

export async function POST(req: Request) {
  const session = await getServerSession();
  if (!session) return new Response('Unauthorized', { status: 401 });
  
  const { success } = await ratelimit.limit(session.user.id);
  if (!success) return new Response('Rate limit exceeded', { status: 429 });
  
  const stream = await openai.chat.completions.create({ ... });
  return new Response(stream);
}`,
    fixImpact: 'API keys protected on the server, rate-limited per user, preventing malicious bot drains and uncontrolled API bills.'
  }
];
---

<section id="code-teardown" class="border-b border-ink">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24">

    <div class="max-w-[640px] mb-16">
      <p class="text-small font-bold uppercase tracking-widest text-signal mb-5">
        Senior Architecture Teardown
      </p>
      <h2 class="text-[2.25rem] sm:text-[2.75rem] lg:text-section text-ink">
        How Real AI Bugs Get <span class="text-signal">Engineered &amp; Fixed.</span>
      </h2>
      <p class="mt-6 text-body text-ink max-w-[480px]">
        Explore interactive examples of real failure modes found in AI-generated apps and the
        production-grade fixes applied during a rescue sprint.
      </p>
    </div>

    <!-- Tabs -->
    <div class="flex flex-wrap gap-3 mb-8" role="tablist" aria-label="Code teardown examples">
      {teardowns.map((td, idx) => (
        <button
          type="button"
          role="tab"
          id={`tab-${td.id}`}
          aria-selected={idx === 0 ? 'true' : 'false'}
          aria-controls={td.id}
          tabindex={idx === 0 ? 0 : -1}
          data-target={td.id}
          class="teardown-tab-btn pill"
        >
          {td.shortTitle}
        </button>
      ))}
    </div>

    <!-- Panels -->
    {teardowns.map((td, idx) => (
      <div
        id={td.id}
        role="tabpanel"
        aria-labelledby={`tab-${td.id}`}
        tabindex="0"
        class={`teardown-panel ${idx === 0 ? '' : 'hidden'}`}
      >
        <div class="frame">
          <div class="p-6 sm:p-8 border-b border-ink">
            <div class="flex flex-wrap items-center gap-3">
              <h3 class="text-sub text-ink">{td.title}</h3>
              <span class="px-2.5 py-1 bg-ember text-cream text-[13px] font-bold">
                {td.riskLevel}
              </span>
            </div>
            <p class="mt-3 text-body text-ink max-w-[640px]">{td.context}</p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2">
            <!-- Before -->
            <div class="border-b lg:border-b-0 lg:border-r border-ink">
              <div class="px-5 py-3 bg-ember text-cream flex items-center justify-between gap-3">
                <span class="font-mono text-[13px] font-bold">BEFORE: Vulnerable AI Code</span>
                <span class="font-mono text-[13px]">Flawed &amp; Dangerous</span>
              </div>
              <pre class="p-5 text-[13px] leading-relaxed overflow-x-auto whitespace-pre"><code>{td.vibeCode}</code></pre>
            </div>

            <!-- After -->
            <div>
              <div class="px-5 py-3 bg-signal text-cream flex items-center justify-between gap-3">
                <span class="font-mono text-[13px] font-bold">AFTER: Hardened Architecture</span>
                <span class="font-mono text-[13px]">Tested &amp; Scalable</span>
              </div>
              <pre class="p-5 text-[13px] leading-relaxed overflow-x-auto whitespace-pre"><code>{td.rescueCode}</code></pre>
            </div>
          </div>

          <div class="p-6 sm:p-8 border-t border-ink flex items-start gap-4">
            <span class="w-3 h-3 mt-1.5 shrink-0 bg-signal" aria-hidden="true"></span>
            <p class="text-body text-ink">
              <strong class="font-bold">Remediation Impact:</strong> {td.fixImpact}
            </p>
          </div>
        </div>
      </div>
    ))}

    <!-- Credentials & guarantee -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 border-t border-l border-ink">
      <div class="border-r border-b border-ink p-6 sm:p-8">
        <span class="block w-10 h-10 bg-ink mb-6" style="clip-path: circle(50% at 50% 50%);" aria-hidden="true"></span>
        <h3 class="text-sub text-ink">Principal Engineer Direct</h3>
        <p class="mt-4 text-body text-ink">
          10+ years of high-scale cloud architecture, production PostgreSQL, and full-stack TypeScript
          experience. No junior contractors or outsourced handoffs—every line of your code is reviewed
          and stabilized by a senior engineer.
        </p>
      </div>

      <div class="border-r border-b border-ink p-6 sm:p-8">
        <span class="block w-10 h-10 bg-saffron mb-6" aria-hidden="true"></span>
        <h3 class="text-sub text-ink">100% Risk-Free Diagnostic Guarantee</h3>
        <p class="mt-4 text-body text-ink">
          If the initial 48-Hour Code Diagnostic fails to identify actionable, high-severity
          architectural, security, or stability improvements in your codebase, your audit fee is 100%
          refunded immediately. No questions asked.
        </p>
      </div>
    </div>

  </div>
</section>

<script>
  const tabBtns = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.teardown-tab-btn')
  );
  const panels = document.querySelectorAll<HTMLElement>('.teardown-panel');

  const select = (btn: HTMLButtonElement, focus = false) => {
    const targetId = btn.getAttribute('data-target');
    if (!targetId) return;

    tabBtns.forEach((b) => {
      const active = b === btn;
      b.setAttribute('aria-selected', String(active));
      b.tabIndex = active ? 0 : -1;
      b.classList.toggle('pill-signal', active);
    });

    panels.forEach((panel) => {
      panel.classList.toggle('hidden', panel.id !== targetId);
    });

    if (focus) btn.focus();
  };

  tabBtns.forEach((btn, i) => {
    btn.addEventListener('click', () => select(btn));

    // Roving tabindex: arrow keys move between tabs, Home/End jump to ends.
    btn.addEventListener('keydown', (e) => {
      const keys: Record<string, number> = {
        ArrowRight: i + 1,
        ArrowLeft: i - 1,
        Home: 0,
        End: tabBtns.length - 1,
      };
      const next = keys[e.key];
      if (next === undefined) return;
      e.preventDefault();
      select(tabBtns[(next + tabBtns.length) % tabBtns.length], true);
    });
  });

  if (tabBtns[0]) select(tabBtns[0]);
</script>
