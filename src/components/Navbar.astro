---
---

<header class="sticky top-0 z-50 w-full border-b border-slate-800/80 bg-[#060911]/80 backdrop-blur-xl transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18">
      
      <!-- Brand Logo -->
      <a href="#" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 p-0.5 shadow-lg shadow-sky-500/20 group-hover:shadow-sky-500/40 transition-all duration-300">
          <div class="w-full h-full bg-[#090d16] rounded-[10px] flex items-center justify-center">
            <svg class="w-5 h-5 text-sky-400 group-hover:scale-110 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
        </div>
        <div class="flex flex-col">
          <span class="text-base font-bold tracking-tight text-white flex items-center gap-2">
            Vibe Code Rescue
            <span class="text-[10px] font-semibold tracking-wider uppercase px-2 py-0.5 rounded-full bg-sky-500/10 text-sky-400 border border-sky-500/20 hidden sm:inline-block">
              Fractional
            </span>
          </span>
          <span class="text-xs text-slate-400 font-medium">Senior Engineering for AI Apps</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300" aria-label="Main Navigation">
        <a href="#the-wall" class="hover:text-sky-400 transition-colors">The Problem</a>
        <a href="#how-it-works" class="hover:text-sky-400 transition-colors">How It Works</a>
        <a href="#code-teardown" class="hover:text-sky-400 transition-colors flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Teardown
        </a>
        <a href="#pricing" class="hover:text-sky-400 transition-colors">Pricing</a>
        <a href="#tech-stack" class="hover:text-sky-400 transition-colors">Stack</a>
        <a href="#faq" class="hover:text-sky-400 transition-colors">FAQ</a>
      </nav>

      <!-- Right CTA -->
      <div class="hidden sm:flex items-center gap-4">
        <a 
          href="#triage" 
          id="nav-cta-btn"
          class="relative inline-flex items-center justify-center px-5 py-2.5 text-xs sm:text-sm font-semibold text-white rounded-xl bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 shadow-md shadow-sky-500/20 hover:shadow-sky-500/40 hover:-translate-y-0.5 transition-all duration-200"
        >
          Book Free Triage
          <svg class="w-4 h-4 ml-1.5 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="flex md:hidden">
        <button 
          id="mobile-menu-toggle"
          type="button" 
          class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800/60 focus:outline-none"
          aria-label="Toggle navigation menu"
        >
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-800 bg-[#090d16] px-4 pt-2 pb-6 space-y-3">
    <a href="#the-wall" class="block px-3 py-2 rounded-lg text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">The Problem</a>
    <a href="#how-it-works" class="block px-3 py-2 rounded-lg text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">How It Works</a>
    <a href="#code-teardown" class="block px-3 py-2 rounded-lg text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">Code Teardown</a>
    <a href="#pricing" class="block px-3 py-2 rounded-lg text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">Pricing & Packages</a>
    <a href="#tech-stack" class="block px-3 py-2 rounded-lg text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">Supported Tech</a>
    <a href="#faq" class="block px-3 py-2 rounded-lg text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">FAQ</a>
    <div class="pt-2">
      <a href="#triage" class="w-full inline-flex items-center justify-center px-4 py-3 text-sm font-semibold text-white rounded-xl bg-gradient-to-r from-sky-500 to-indigo-600 shadow-md">
        Book Free 15-Min Triage
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.contains('hidden');
      if (isOpen) {
        mobileMenu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      } else {
        mobileMenu.classList.remove('hidden');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      }
    });

    // Close on link click
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }
</script>
