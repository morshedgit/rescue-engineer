---
const steps = [
  {
    step: '01',
    title: '48-Hour Code Diagnostic',
    tagline: 'Deep Triage & Risk Matrix',
    description: 'Grant temporary GitHub repository access. Within 48 hours, I perform an in-depth senior architectural and security review of your codebase, database schemas, auth layer, and API connections.',
    deliverables: [
      'Prioritized Vulnerability & Bug Audit report',
      'What to fix immediately vs what to leave alone',
      'Architecture teardown & performance bottlenecks',
      '30-minute 1-on-1 video walkthrough call'
    ],
    timeframe: 'Turnaround: 48 Hours',
    accent: 'bg-ember'
  },
  {
    step: '02',
    title: 'Scoped Stabilization Sprint',
    tagline: 'Hands-On Senior Remediation',
    description: 'A dedicated 1–2 week sprint where I get hands-on in your repository to fix critical security flaws, configure Postgres RLS policies, harden payments, resolve race conditions, and set up automated tests.',
    deliverables: [
      'Complete security & auth hardening (Zero-trust RLS)',
      'Database migration & schema consistency cleanup',
      'Reliable Stripe / webhook handling with idempotency',
      'Automated CI/CD build tests preventing regressions'
    ],
    timeframe: 'Duration: 1–2 Weeks',
    accent: 'bg-saffron'
  },
  {
    step: '03',
    title: 'Ship & Keep Building Safely',
    tagline: 'Production Ready + AI Prompts Ready',
    description: 'You receive a stabilized, production-ready application with clean architecture, comprehensive documentation, and prompt guidelines so you can continue building features with AI safely.',
    deliverables: [
      'Production-grade deployment on Cloudflare/Vercel/AWS',
      'Clean architectural documentation & schema maps',
      'AI Prompting Guidelines for sustainable future changes',
      '14 days of post-rescue monitoring & support'
    ],
    timeframe: 'Outcome: Launch Ready',
    accent: 'bg-signal'
  }
];
---

<section id="how-it-works" class="border-b border-ink">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24">

    <div class="max-w-[640px] mb-16">
      <p class="text-small font-bold uppercase tracking-widest text-signal mb-5">
        The Rescue Process
      </p>
      <h2 class="text-[2.25rem] sm:text-[2.75rem] lg:text-section text-ink">
        From Breaking Prototype to <span class="text-signal">Production in 3 Steps.</span>
      </h2>
      <p class="mt-6 text-body text-ink max-w-[480px]">
        No endless agency meetings or junior delegates. You work directly with a senior software
        architect with a transparent, sprint-based approach.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 border-t border-l border-ink">
      {steps.map((s) => (
        <div class="border-r border-b border-ink p-6 sm:p-8 flex flex-col">
          <div class="flex items-center gap-4 mb-6">
            <span class={`w-12 h-12 shrink-0 ${s.accent}`} aria-hidden="true"></span>
            <span class="font-display text-[2.5rem] leading-none text-ink">{s.step}</span>
          </div>

          <p class="font-mono text-[13px] text-ink/60">{s.tagline}</p>
          <h3 class="text-sub text-ink mt-2">{s.title}</h3>

          <p class="mt-4 text-body text-ink">{s.description}</p>

          <div class="mt-6 pt-5 border-t border-ink flex-1">
            <p class="text-[13px] font-bold uppercase tracking-widest text-ink/60 mb-3">
              You Receive:
            </p>
            <ul class="space-y-2">
              {s.deliverables.map((d) => (
                <li class="flex items-start gap-3 text-small">
                  <span class="w-2 h-2 mt-2 shrink-0 bg-ink" aria-hidden="true"></span>
                  <span>{d}</span>
                </li>
              ))}
            </ul>
          </div>

          <p class="mt-6 pt-4 border-t border-ink font-mono text-[13px] font-bold text-signal">
            {s.timeframe}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-14">
      <a href="#triage" class="pill pill-signal">Start with Step 1: Book Free 15-Min Triage</a>
    </div>

  </div>
</section>
