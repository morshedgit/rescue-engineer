---
const packages = [
  {
    id: 'pkg-audit',
    name: 'Production Readiness Audit',
    badge: 'Fast Triage',
    price: '$750 – $1,250',
    frequency: 'Fixed price • 48-hr turnaround',
    description: 'Perfect for founders with a working prototype who want a senior engineer to inspect security, auth, and database schemas before launch or investor demos.',
    deliverables: [
      'Comprehensive Security & Auth/RLS audit',
      'Database schema & performance bottleneck report',
      'Prioritized fix roadmap (Critical vs Non-critical)',
      '30-minute 1-on-1 video walkthrough call',
      'Direct GitHub issues with code fix snippets',
      '100% Money-back guarantee if no high-impact bugs found'
    ],
    ctaText: 'Book 48-Hr Audit',
    ctaLink: '#triage',
    popular: false
  },
  {
    id: 'pkg-sprint',
    name: 'Rescue Sprint',
    badge: 'Most Popular • Hands-On',
    price: '$3,500 – $6,500',
    frequency: '1–2 Weeks Dedicated Sprint',
    description: 'The complete hands-on remediation package. I jump directly into your repository, resolve all critical vulnerabilities, fix broken payments, and configure production deployments.',
    deliverables: [
      'Hands-on resolution of all critical vulnerabilities',
      'Zero-trust Supabase/Postgres RLS policy implementation',
      'Idempotent Stripe & webhook payment stabilization',
      'Database migration & schema consistency fixes',
      'Automated CI/CD deployment pipeline on Cloudflare/Vercel',
      'Clean architectural documentation & Prompting Guide',
      '14 days of dedicated post-launch support'
    ],
    ctaText: 'Start Rescue Sprint',
    ctaLink: '#triage',
    popular: true
  },
  {
    id: 'pkg-advisory',
    name: 'Fractional Advisory',
    badge: 'Ongoing Retainer',
    price: '$1,500 – $3,000',
    frequency: 'Per month • 2 slots available',
    description: 'For non-technical founders and solo creators actively building with Cursor, Lovable, or Bolt who need ongoing architectural guardrails and prompt review.',
    deliverables: [
      'Weekly architectural sync & roadmap guidance',
      'Async PR and code reviews via GitHub',
      'Prompt engineering & system design advice',
      'Emergency bug escalation & live debugging',
      'Database scaling and cloud infrastructure reviews',
      'Cancel or pause anytime with 14 days notice'
    ],
    ctaText: 'Inquire About Advisory',
    ctaLink: '#triage',
    popular: false
  }
];
---

<section id="pricing" class="border-b border-ink">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24">

    <div class="max-w-[640px] mb-16">
      <p class="text-small font-bold uppercase tracking-widest text-signal mb-5">
        Transparent Pricing
      </p>
      <h2 class="text-[2.25rem] sm:text-[2.75rem] lg:text-section text-ink">
        Fixed Scope. Transparent Pricing. <span class="text-signal">Zero Hidden Retainers.</span>
      </h2>
      <p class="mt-6 text-body text-ink max-w-[480px]">
        Choose between an actionable 48-hour diagnostic, a full hands-on rescue sprint, or fractional
        senior advisory as you scale.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 border-t border-l border-ink">
      {packages.map((pkg) => (
        <div class={`border-r border-b border-ink p-6 sm:p-8 flex flex-col ${pkg.popular ? 'bg-signal text-cream' : ''}`}>

          <span class={`inline-block self-start px-2.5 py-1 text-[13px] font-bold border ${pkg.popular ? 'border-cream' : 'border-ink'}`}>
            {pkg.badge}
          </span>

          <h3 class={`text-sub mt-5 ${pkg.popular ? 'text-cream' : 'text-ink'}`}>{pkg.name}</h3>
          <p class="mt-3 text-small">{pkg.description}</p>

          <div class={`mt-6 pt-6 border-t ${pkg.popular ? 'border-cream/40' : 'border-ink'}`}>
            <div class="font-display text-[2.5rem] leading-none">{pkg.price}</div>
            <div class="mt-2 font-mono text-[13px]">{pkg.frequency}</div>
          </div>

          <div class={`mt-6 pt-6 border-t flex-1 ${pkg.popular ? 'border-cream/40' : 'border-ink'}`}>
            <p class="text-[13px] font-bold uppercase tracking-widest mb-3 opacity-70">
              Included Deliverables:
            </p>
            <ul class="space-y-2">
              {pkg.deliverables.map((item) => (
                <li class="flex items-start gap-3 text-small">
                  <span
                    class={`w-2 h-2 mt-2 shrink-0 ${pkg.popular ? 'bg-cream' : 'bg-ink'}`}
                    aria-hidden="true"
                  ></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-8">
            <a
              href={pkg.ctaLink}
              class={`pill w-full ${pkg.popular ? 'border-cream text-cream hover:bg-cream hover:text-signal' : ''}`}
            >
              {pkg.ctaText}
            </a>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-10 text-small text-ink">
      Custom scopes and emergency launch timelines available on request during triage.
    </p>

  </div>
</section>
