---
const stackCategories = [
  {
    category: 'AI Prototyping Ecosystem',
    description: 'Tools where prototypes originate and where prompt history starts stalling.',
    items: [
      { name: 'Cursor AI', tag: 'IDE & Agent' },
      { name: 'Lovable.dev', tag: 'Full-Stack Web' },
      { name: 'Bolt.new', tag: 'Browser StackBlitz' },
      { name: 'Replit Agent', tag: 'Cloud Workspace' },
      { name: 'v0 by Vercel', tag: 'Generative UI' },
      { name: 'Claude Code', tag: 'CLI & Multi-file' }
    ]
  },
  {
    category: 'Frontend & Frameworks',
    description: 'Modern, reactive frameworks requiring clean state management and build hygiene.',
    items: [
      { name: 'Next.js 14 / 15', tag: 'App Router / SSR' },
      { name: 'React 18 / 19', tag: 'Server Components' },
      { name: 'TypeScript', tag: 'Strict Type-Safety' },
      { name: 'Tailwind CSS', tag: 'UI Architecture' },
      { name: 'Astro', tag: 'Content & Edge' },
      { name: 'Vite', tag: 'Fast Bundling' }
    ]
  },
  {
    category: 'Databases & Backend Infrastructure',
    description: 'Data layers requiring zero-trust security policies, migrations, and indexing.',
    items: [
      { name: 'Supabase', tag: 'PostgreSQL + RLS' },
      { name: 'PostgreSQL', tag: 'Relational DB' },
      { name: 'Firebase / Firestore', tag: 'NoSQL & Security Rules' },
      { name: 'Prisma / Drizzle ORM', tag: 'Type-safe Queries' },
      { name: 'Node.js / Express', tag: 'REST & GraphQL' },
      { name: 'Python / FastAPI', tag: 'AI & Data Services' }
    ]
  },
  {
    category: 'Payments, Auth & Cloud Hosting',
    description: 'Critical infrastructure where customer money and authentication flow.',
    items: [
      { name: 'Stripe', tag: 'Billing & Webhooks' },
      { name: 'Clerk / Auth0', tag: 'Session Security' },
      { name: 'Cloudflare Pages & Workers', tag: 'Global Edge CDN' },
      { name: 'Vercel', tag: 'Edge Functions' },
      { name: 'AWS (S3, Lambda, RDS)', tag: 'Cloud Scalability' },
      { name: 'Upstash Redis', tag: 'Rate Limiting & Queue' }
    ]
  }
];
---

<section id="tech-stack" class="border-b border-ink">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24">

    <div class="max-w-[640px] mb-16">
      <p class="text-small font-bold uppercase tracking-widest text-signal mb-5">
        Supported Ecosystem
      </p>
      <h2 class="text-[2.25rem] sm:text-[2.75rem] lg:text-section text-ink">
        Built for the Modern <span class="text-signal">AI &amp; Full-Stack Landscape.</span>
      </h2>
      <p class="mt-6 text-body text-ink max-w-[480px]">
        Whether your app was built in 2 hours with Lovable or engineered with Cursor + Supabase, we
        support the full modern tech stack.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 border-t border-l border-ink">
      {stackCategories.map((cat) => (
        <div class="border-r border-b border-ink p-6 sm:p-8">
          <h3 class="text-sub text-ink">{cat.category}</h3>
          <p class="mt-2 text-small text-ink/70">{cat.description}</p>

          <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-x-6">
            {cat.items.map((item) => (
              <li class="py-2.5 border-t border-ink/20">
                <span class="block text-small font-bold text-ink">{item.name}</span>
                <span class="block font-mono text-[13px] text-ink/60">{item.tag}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="mt-10 text-body text-ink max-w-[640px]">
      Using an unlisted technology, custom Python AI service, or self-hosted server?
      <a href="#triage" class="font-bold text-signal underline underline-offset-4">Ask during the code triage call</a>.
    </p>

  </div>
</section>
