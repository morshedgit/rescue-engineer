---
const failureModes = [
  {
    shape: 'square',
    accent: 'bg-ember',
    title: 'Broken Auth & Exposed Data',
    subtitle: 'Vulnerability #1 in AI apps',
    description: 'AI tools often write authentication logic directly on the client side or leave PostgreSQL / Supabase Row Level Security (RLS) completely disabled—allowing anyone with DevTools to view your entire user database.',
    symptoms: [
      'Database tables open with public read/write access',
      'Leaked Supabase service_role keys in client bundles',
      'Admin routes protected only by CSS or front-end redirects',
      'Missing session expiration and unverified JWTs'
    ],
    tag: 'Critical Security Risk'
  },
  {
    shape: 'circle',
    accent: 'bg-saffron',
    title: 'Database & State Chaos',
    subtitle: 'Race conditions & ghost records',
    description: 'As prompt history builds up, AI forgets foreign key relationships, duplicates schema columns, and introduces unhandled asynchronous state race conditions that corrupt customer records.',
    symptoms: [
      'Sluggish queries and un-indexed full table scans',
      'Foreign key mismatch leading to orphaned customer data',
      'React state flickering and stale cache bugs',
      'No database migrations—breaking changes made live'
    ],
    tag: 'Data Integrity'
  },
  {
    shape: 'triangle',
    // Blush/saffron are illustration hues — they only read when adjacent to
    // ink inside a composition. As a lone marker on cream, ink is the choice.
    accent: 'bg-ink',
    title: 'Failed Integrations & Payments',
    subtitle: 'Lost revenue & broken webhooks',
    description: 'AI code generates standard "happy path" Stripe and API integrations but misses webhook signature verification, replay protection, retry logic, and API rate-limiting edge cases.',
    symptoms: [
      'Stripe payments processed but subscriptions not upgraded',
      'Duplicate billing due to missing idempotency keys',
      'Third-party APIs failing silently without error telemetry',
      'Unhandled rate limits crashing background workers'
    ],
    tag: 'Revenue Loss'
  },
  {
    shape: 'semicircle',
    accent: 'bg-signal',
    title: 'Deployment & Build Hell',
    subtitle: 'Works locally, fails on Vercel/Cloudflare',
    description: 'When it is time to push to production, cryptic TypeScript compilation errors, environment variable mismatches, dynamic server rendering conflicts, and broken routing stall your launch for days.',
    symptoms: [
      'Vercel or Cloudflare build failing with TS errors',
      'Environment variables returning undefined in production',
      'CORS errors blocking API and auth communication',
      'AI giving circular suggestions that break previous code'
    ],
    tag: 'Launch Blocker'
  }
];

const clip: Record<string, string> = {
  square: '',
  circle: 'clip-path: circle(50% at 50% 50%);',
  triangle: 'clip-path: polygon(50% 0, 100% 100%, 0 100%);',
  semicircle: 'clip-path: polygon(0 0, 100% 0, 100% 50%, 0 50%); border-radius: 9999px 9999px 0 0;'
};
---

<section id="the-wall" class="border-b border-ink">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24">

    <!-- Section header -->
    <div class="max-w-[640px] mb-16">
      <p class="text-small font-bold uppercase tracking-widest text-signal mb-5">
        The Reality of AI Prototyping
      </p>
      <h2 class="text-[2.25rem] sm:text-[2.75rem] lg:text-section text-ink">
        You Hit the <span class="text-signal">"Vibe Coding Wall".</span>
      </h2>
      <p class="mt-6 text-body text-ink max-w-[480px]">
        AI coding assistants are magical for generating initial 80% prototypes. But when you add real
        users, transactions, and security requirements, AI tools hallucinate, create circular fixes,
        and compound structural debt.
      </p>
    </div>

    <!-- Four failure modes on a schematic hairline grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 border-t border-l border-ink">
      {failureModes.map((mode, index) => (
        <div class="border-r border-b border-ink p-6 sm:p-8">
          <div class="flex items-start justify-between gap-4 mb-6">
            <span class={`w-10 h-10 shrink-0 ${mode.accent}`} style={clip[mode.shape]} aria-hidden="true"></span>
            <span class="px-2.5 py-1 border border-ink text-[13px] font-bold whitespace-nowrap">
              {mode.tag}
            </span>
          </div>

          <p class="font-mono text-[13px] text-ink/60">
            Failure Mode 0{index + 1} • {mode.subtitle}
          </p>
          <h3 class="text-sub text-ink mt-2">{mode.title}</h3>

          <p class="mt-4 text-body text-ink">{mode.description}</p>

          <div class="mt-6 pt-5 border-t border-ink">
            <p class="text-[13px] font-bold uppercase tracking-widest text-ink/60 mb-3">
              Common Signs:
            </p>
            <ul class="space-y-2">
              {mode.symptoms.map((symptom) => (
                <li class="flex items-start gap-3 text-small">
                  <span class="w-2 h-2 mt-2 shrink-0 bg-ink" aria-hidden="true"></span>
                  <span>{symptom}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <!-- Empathy callout -->
    <div class="mt-16 max-w-[640px]">
      <h3 class="text-sub text-ink">Don't throw away your app and start over from scratch.</h3>
      <p class="mt-4 text-body text-ink max-w-[480px]">
        Your prototype proved the market idea. Instead of burning weeks in frustrating prompt loops,
        get a senior software engineer to stabilize your existing code in 48 hours.
      </p>
      <div class="mt-6">
        <a href="#triage" class="ghost-link">Get a 48-Hour Code Diagnostic Report</a>
      </div>
    </div>

  </div>
</section>
