---
const currentYear = new Date().getFullYear();

const navLinks = [
  { href: '#the-wall', label: 'The Vibe Coding Wall' },
  { href: '#how-it-works', label: '3-Step Rescue Process' },
  { href: '#code-teardown', label: 'Architecture Teardown' },
  { href: '#pricing', label: 'Services & Pricing' },
  { href: '#tech-stack', label: 'Supported Ecosystem' },
  { href: '#faq', label: 'Frequently Asked Questions' }
];

const guarantees = [
  '48-Hour Diagnostic Report',
  '100% Audit Refund Guarantee',
  'Strict Bilateral NDA Protection',
  '100% IP & Repository Ownership'
];
---

<footer class="bg-signal text-cream">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24">

    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">

      <div class="md:col-span-2">
        <div class="flex items-center gap-3">
          <svg class="w-8 h-8" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="0" y="0" width="15" height="15" fill="currentColor" />
            <circle cx="24.5" cy="7.5" r="7.5" fill="currentColor" opacity="0.55" />
            <path d="M0 32 L7.5 17 L15 32 Z" fill="currentColor" opacity="0.55" />
            <rect x="17" y="17" width="15" height="15" fill="currentColor" />
          </svg>
          <span class="font-display text-sub">Vibe Code Rescue</span>
        </div>

        <p class="mt-6 text-body max-w-[480px]">
          Independent Fractional Senior Engineering consultancy bridging the gap between rapid AI
          prototyping (Cursor, Lovable, Bolt, Replit) and production-grade reliability, security,
          and scalability.
        </p>

        <p class="mt-6 text-small font-bold">
          Zero Junior Contractors • Principal Software Architect Direct
        </p>
      </div>

      <div>
        <h3 class="text-[13px] font-bold uppercase tracking-widest mb-5">Navigation</h3>
        <ul class="space-y-3">
          {navLinks.map((l) => (
            <li>
              <a href={l.href} class="text-small hover:underline underline-offset-4">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-[13px] font-bold uppercase tracking-widest mb-5">Guarantees &amp; Security</h3>
        <ul class="space-y-3">
          {guarantees.map((g) => (
            <li class="flex items-start gap-3 text-small">
              <span class="w-2 h-2 mt-2 shrink-0 bg-cream" aria-hidden="true"></span>
              <span>{g}</span>
            </li>
          ))}
        </ul>
        <div class="mt-6">
          <a href="#triage" class="pill border-cream text-cream hover:bg-cream hover:text-signal">
            Book Code Triage
          </a>
        </div>
      </div>

    </div>

    <div class="mt-16 pt-8 border-t border-cream/40 flex flex-col sm:flex-row items-start justify-between gap-4 text-[13px]">
      <p>&copy; {currentYear} Vibe Code Rescue. All rights reserved.</p>
      <p class="sm:text-right max-w-md">
        Disclaimer: Independent engineering service. Not officially affiliated with or endorsed by
        Cursor (Anysphere), Lovable, Bolt.new (StackBlitz), Replit, or Vercel.
      </p>
    </div>

  </div>
</footer>
