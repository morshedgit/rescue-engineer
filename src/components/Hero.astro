---
const supportedTools = [
  { name: 'Cursor', logo: '⚡' },
  { name: 'Lovable', logo: '❤️' },
  { name: 'Bolt.new', logo: '⚡' },
  { name: 'Replit', logo: '🌀' },
  { name: 'v0 by Vercel', logo: '▲' },
  { name: 'Claude Code', logo: '✳️' },
];
---

<section class="relative pt-12 pb-20 lg:pt-20 lg:pb-28 overflow-hidden">
  <!-- Subtle Background Gradients -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] sm:w-[900px] h-[400px] bg-gradient-to-tr from-sky-500/15 via-indigo-500/10 to-transparent blur-3xl pointer-events-none rounded-full"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3.5xl mx-auto space-y-6">
      
      <!-- Eyebrow Pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/80 border border-slate-700/60 shadow-inner backdrop-blur-md">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-sky-500"></span>
        </span>
        <span class="text-xs font-semibold text-slate-200 tracking-wide">
          Fractional Senior Engineering & Security Audits for AI Apps
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.15]">
        Fix, Secure, and Ship Your <br class="hidden sm:inline" />
        <span class="gradient-text-accent">AI-Built Prototype.</span>
      </h1>

      <!-- Sub-headline -->
      <p class="text-lg sm:text-xl text-slate-300 font-normal leading-relaxed max-w-2xl mx-auto">
        Hit a wall with <strong class="text-white font-semibold">Lovable</strong>, <strong class="text-white font-semibold">Bolt</strong>, <strong class="text-white font-semibold">Cursor</strong>, or <strong class="text-white font-semibold">Replit</strong>? I take your vibe-coded prototype, eliminate security and database vulnerabilities, and turn it into stable production software.
      </p>

      <!-- CTAs -->
      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="#triage" 
          id="hero-primary-cta"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white rounded-xl bg-gradient-to-r from-sky-500 via-indigo-600 to-sky-500 bg-[length:200%_auto] hover:bg-[position:right_center] shadow-xl shadow-sky-500/25 hover:shadow-sky-500/40 hover:-translate-y-0.5 transition-all duration-300"
        >
          Book a Free 15-Min Code Triage
          <svg class="w-5 h-5 ml-2 text-white/90" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a 
          href="#pricing" 
          id="hero-secondary-cta"
          class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-4 text-base font-semibold text-slate-200 rounded-xl bg-slate-900/90 border border-slate-700/80 hover:bg-slate-800 hover:text-white hover:border-slate-600 transition-all duration-200"
        >
          View Audit Scope & Pricing
        </a>
      </div>

      <!-- Trust Pillars -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs sm:text-sm text-slate-400">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          <span>48-Hour Diagnostic Turnaround</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          <span>100% Risk-Free Refund Guarantee</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          <span>Senior Principal Engineer Direct</span>
        </div>
      </div>

      <!-- Code Terminal Preview Mockup -->
      <div class="pt-10 max-w-4xl mx-auto text-left">
        <div class="rounded-2xl border border-slate-800 bg-[#090d16]/95 shadow-2xl overflow-hidden backdrop-blur-xl">
          <!-- Terminal Header -->
          <div class="flex items-center justify-between px-4 py-3 border-b border-slate-800 bg-slate-900/60">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
              <span class="ml-2 text-xs font-mono text-slate-400">rescue-audit.ts — Vibe Code Triage</span>
            </div>
            <div class="flex items-center gap-2 text-xs font-mono text-slate-400">
              <span class="px-2 py-0.5 rounded bg-rose-500/10 text-rose-400 border border-rose-500/20 font-semibold">
                3 Critical Flaws Found
              </span>
              <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-semibold">
                Remediated in 48h
              </span>
            </div>
          </div>

          <!-- Code Content Preview -->
          <div class="p-4 sm:p-6 font-mono text-xs sm:text-sm space-y-3 leading-relaxed overflow-x-auto">
            <div class="text-slate-500">// 1. Vibe-coded prototype issue: Client-side auth check with exposed Supabase Service Key</div>
            <div class="p-3 rounded-lg bg-rose-950/20 border border-rose-500/20 text-rose-300">
              <div class="flex items-center gap-2 text-rose-400 font-bold mb-1">
                <span>✕ Vulnerability:</span> Open Database & Exposed Secret
              </div>
              <span class="text-rose-400">- const supabase = createClient(URL, NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY)</span><br />
              <span class="text-rose-400">- if (user.role === 'admin') // Easily bypassed in DevTools!</span>
            </div>

            <div class="text-slate-500">// 2. Production Rescue: Enforce Server-side JWT verification & Row Level Security (RLS)</div>
            <div class="p-3 rounded-lg bg-emerald-950/20 border border-emerald-500/20 text-emerald-300">
              <div class="flex items-center gap-2 text-emerald-400 font-bold mb-1">
                <span>✓ Production Fix:</span> Zero-trust RLS + Server-Only Credentials
              </div>
              <span class="text-emerald-400">+ const &#123; data, error &#125; = await supabaseServer.from('billing').select('*')</span><br />
              <span class="text-emerald-400">+ // PostgreSQL RLS ensures auth.uid() = user_id at the database level</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Supported AI Prototyping Tools -->
      <div class="pt-12">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-300 mb-6">
          Supporting Founders & Creators Building With:
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
          {supportedTools.map((tool) => (
            <div class="flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900/60 border border-slate-800 hover:border-slate-700 hover:bg-slate-800/60 transition-colors">
              <span class="text-base">{tool.logo}</span>
              <span class="text-xs sm:text-sm font-semibold text-slate-200">{tool.name}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
