---
const supportedTools = ['Cursor', 'Lovable', 'Bolt.new', 'Replit', 'v0 by Vercel', 'Claude Code'];
---

<section class="border-b border-ink">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">

    <!-- Two-Column Feature Section: copy left, geometric illustration right -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-26 items-center">

      <div>
        <p class="text-small font-bold uppercase tracking-widest text-signal mb-6">
          Fractional Senior Engineering &amp; Security Audits
        </p>

        <!-- Hero Display Heading: two-tone, one blue phrase only -->
        <h1 class="text-[3rem] sm:text-[4rem] lg:text-hero text-ink">
          Fix, Secure, and Ship Your <span class="text-signal">AI-Built Prototype.</span>
        </h1>

        <!-- Body Paragraph Block: 18px/1.78, capped ~480px -->
        <p class="mt-8 text-body text-ink max-w-[480px]">
          Hit a wall with <strong class="font-bold">Lovable</strong>, <strong class="font-bold">Bolt</strong>, <strong class="font-bold">Cursor</strong>, or <strong class="font-bold">Replit</strong>?
          I take your vibe-coded prototype, eliminate security and database vulnerabilities, and turn it
          into stable production software.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row gap-4">
          <a href="#triage" id="hero-primary-cta" class="pill pill-signal">
            Book a Free 15-Min Code Triage
          </a>
          <a href="#pricing" id="hero-secondary-cta" class="pill">
            View Audit Scope &amp; Pricing
          </a>
        </div>

        <ul class="mt-10 space-y-2 text-small text-ink">
          <li class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 bg-ember shrink-0"></span>48-Hour Diagnostic Turnaround
          </li>
          <li class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 bg-ink shrink-0"></span>100% Risk-Free Refund Guarantee
          </li>
          <li class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 bg-signal shrink-0"></span>Senior Principal Engineer Direct
          </li>
        </ul>
      </div>

      <!-- Geometric Illustration Block: Bauhaus primitives, sharp 0px corners -->
      <div class="hidden lg:block" aria-hidden="true">
        <div class="grid grid-cols-3 grid-rows-3 gap-0 w-full max-w-[520px] ml-auto border border-ink">
          <div class="aspect-square bg-ember"></div>
          <div class="aspect-square checkerboard bg-cream"></div>
          <div class="aspect-square bg-cream flex items-end justify-center">
            <div class="w-full h-full" style="background: var(--color-signal); clip-path: polygon(50% 0, 100% 100%, 0 100%);"></div>
          </div>

          <div class="aspect-square bg-signal"></div>
          <div class="aspect-square bg-cream p-3 flex items-center justify-center">
            <div class="starburst w-full h-full opacity-90"></div>
          </div>
          <div class="aspect-square bg-blush"></div>

          <div class="aspect-square bg-cream flex items-center justify-center">
            <div class="w-full h-full bg-ink" style="clip-path: circle(50% at 50% 50%);"></div>
          </div>
          <div class="aspect-square bg-saffron"></div>
          <div class="aspect-square bg-cream flex items-center">
            <div class="w-1/2 h-full bg-ember" style="clip-path: polygon(0 0, 100% 50%, 0 100%);"></div>
            <div class="w-1/2 h-1/2 bg-ink"></div>
          </div>
        </div>
      </div>

    </div>

    <!-- Audit diff: flat, hairline-framed, sharp corners -->
    <div class="mt-20 frame">
      <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-3 border-b border-ink">
        <span class="font-mono text-small font-bold">rescue-audit.ts — Vibe Code Triage</span>
        <span class="flex flex-wrap gap-2 font-mono text-[13px] font-bold">
          <span class="px-2.5 py-1 bg-ember text-cream">3 Critical Flaws Found</span>
          <span class="px-2.5 py-1 bg-signal text-cream">Remediated in 48h</span>
        </span>
      </div>

      <div class="p-5 sm:p-8 font-mono text-[13px] sm:text-small space-y-4 overflow-x-auto">
        <p class="text-ink/60">
          // 1. Vibe-coded prototype issue: Client-side auth check with exposed Supabase Service Key
        </p>
        <div class="border-l-4 border-ember pl-4 py-1">
          <p class="font-bold text-ember mb-1.5">✕ Vulnerability: Open Database &amp; Exposed Secret</p>
          <p>- const supabase = createClient(URL, NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY)</p>
          <p>- if (user.role === 'admin') // Easily bypassed in DevTools!</p>
        </div>

        <p class="text-ink/60">
          // 2. Production Rescue: Enforce Server-side JWT verification &amp; Row Level Security (RLS)
        </p>
        <div class="border-l-4 border-signal pl-4 py-1">
          <p class="font-bold text-signal mb-1.5">✓ Production Fix: Zero-trust RLS + Server-Only Credentials</p>
          <p>+ const &#123; data, error &#125; = await supabaseServer.from('billing').select('*')</p>
          <p>+ // PostgreSQL RLS ensures auth.uid() = user_id at the database level</p>
        </div>
      </div>
    </div>

    <!-- Supported tools -->
    <div class="mt-16">
      <p class="text-small font-bold uppercase tracking-widest text-ink/60 mb-5">
        Supporting Founders &amp; Creators Building With:
      </p>
      <div class="flex flex-wrap gap-3">
        {supportedTools.map((tool) => (
          <span class="px-4 py-2 border border-ink text-small font-bold">{tool}</span>
        ))}
      </div>
    </div>

  </div>
</section>
