---
const tools = [
  { value: 'Cursor', label: 'Cursor AI' },
  { value: 'Lovable', label: 'Lovable.dev' },
  { value: 'Bolt', label: 'Bolt.new' },
  { value: 'Replit', label: 'Replit Agent' },
  { value: 'v0', label: 'v0 by Vercel' },
  { value: 'ClaudeCode', label: 'Claude Code' },
  { value: 'Other', label: 'Other / Mixed' }
];

const blockers = [
  { value: 'SecurityAuth', label: 'Auth & Security / Supabase RLS' },
  { value: 'Database', label: 'Database Schemas & Data Corruptions' },
  { value: 'Deployment', label: 'Build & Deployment Failures' },
  { value: 'Payments', label: 'Stripe & Webhook Errors' },
  { value: 'Performance', label: 'Sluggish Performance & Logic Bugs' },
  { value: 'ContextLimit', label: 'AI Context Window Limit Exceeded' }
];

const field =
  'w-full px-4 py-3 border border-ink bg-cream text-small text-ink placeholder-ink/40 focus:outline-none focus:border-signal focus:ring-1 focus:ring-signal transition-colors';
const label = 'block text-[13px] font-bold uppercase tracking-widest text-ink/70 mb-2';
---

<section id="triage" class="border-b border-ink">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24">

    <div class="max-w-[640px] mb-16">
      <p class="text-small font-bold uppercase tracking-widest text-signal mb-5">
        Fast Track Triage
      </p>
      <h2 class="text-[2.25rem] sm:text-[2.75rem] lg:text-section text-ink">
        Book a Free 15-Min <span class="text-signal">Code Triage Call.</span>
      </h2>
      <p class="mt-6 text-body text-ink max-w-[480px]">
        Let's look at your repository together, diagnose the root blocker, and determine if an audit
        or rescue sprint is right for your app.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-26 items-start">

      <!-- Direct booking -->
      <div>
        <h3 class="text-sub text-ink">Direct Calendar Booking</h3>
        <p class="mt-2 font-mono text-[13px] text-ink/60">
          15-minute high-bandwidth technical review
        </p>

        <p class="mt-6 text-body text-ink max-w-[480px]">
          Pick a time that works for you. We'll hop on a quick screen-share, review your current
          architecture or error logs, and outline immediate next steps.
        </p>

        <div class="mt-8">
          <a
            href="https://cal.com"
            target="_blank"
            rel="noopener noreferrer"
            id="direct-cal-link"
            class="pill pill-signal"
          >
            Open Direct Cal.com Scheduler
          </a>
          <p class="mt-3 text-small text-ink/70">
            Prefer async review first? Fill out the intake form.
          </p>
        </div>

        <div class="mt-10 pt-8 border-t border-ink">
          <p class="text-[13px] font-bold uppercase tracking-widest text-ink/60 mb-4">
            What to expect on the call:
          </p>
          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-small">
              <span class="w-2 h-2 mt-2 shrink-0 bg-ember" aria-hidden="true"></span>
              <span>Zero sales pressure—pure technical triage and feasibility diagnosis.</span>
            </li>
            <li class="flex items-start gap-3 text-small">
              <span class="w-2 h-2 mt-2 shrink-0 bg-ink" aria-hidden="true"></span>
              <span>Under strict NDA: your proprietary logic and idea remain 100% confidential.</span>
            </li>
            <li class="flex items-start gap-3 text-small">
              <span class="w-2 h-2 mt-2 shrink-0 bg-signal" aria-hidden="true"></span>
              <span>Immediate pricing &amp; turnaround confirmation for your specific codebase.</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-6 border-t border-ink flex flex-wrap items-center justify-between gap-3 text-[13px]">
          <span class="font-bold">Booking Slots Open for This Week</span>
          <span class="font-mono text-ink/60">Avg response: &lt; 4 hrs</span>
        </div>
      </div>

      <!-- Intake form -->
      <div class="frame p-6 sm:p-8">
        <h3 class="text-sub text-ink">Quick Code Intake Form</h3>
        <p class="mt-2 text-small text-ink/70">
          Provide details about your app and get a personalized diagnostic assessment.
        </p>

        <form id="intake-form" class="mt-8 space-y-5">

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="intake-name" class={label}>Your Name *</label>
              <input type="text" id="intake-name" name="name" required placeholder="e.g. Alex Morgan" class={field} />
            </div>
            <div>
              <label for="intake-email" class={label}>Work / Personal Email *</label>
              <input type="email" id="intake-email" name="email" required placeholder="alex@company.com" class={field} />
            </div>
          </div>

          <div>
            <label for="intake-url" class={label}>App URL or GitHub Repo Link (optional)</label>
            <input type="text" id="intake-url" name="url" placeholder="https://github.com/user/app" class={field} />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="intake-tool" class={label}>AI Tool Used *</label>
              <select id="intake-tool" name="tool" required class={field}>
                {tools.map((t) => <option value={t.value}>{t.label}</option>)}
              </select>
            </div>
            <div>
              <label for="intake-blocker" class={label}>Primary Blocker *</label>
              <select id="intake-blocker" name="blocker" required class={field}>
                {blockers.map((b) => <option value={b.value}>{b.label}</option>)}
              </select>
            </div>
          </div>

          <div>
            <label for="intake-message" class={label}>What is breaking or what do you need to ship?</label>
            <textarea
              id="intake-message"
              name="message"
              rows="4"
              placeholder="e.g. Supabase auth is not restricting user access, and Vercel build fails with TypeScript errors on stripe webhook."
              class={`${field} resize-none`}></textarea>
          </div>

          <button type="submit" id="intake-submit-btn" class="pill pill-signal w-full">
            Submit Intake for Rapid Review
          </button>

          <div id="form-feedback-success" class="hidden p-5 border border-signal">
            <p class="font-bold text-signal">Intake Request Received!</p>
            <p class="mt-2 text-small text-ink">
              Thank you! I will review your project details and reach out within 4 business hours with
              an initial diagnostic assessment.
            </p>
          </div>

        </form>
      </div>

    </div>
  </div>
</section>

<script>
  // Form submission handler
  const form = document.getElementById('intake-form') as HTMLFormElement | null;
  const feedbackSuccess = document.getElementById('form-feedback-success');
  const submitBtn = document.getElementById('intake-submit-btn') as HTMLButtonElement | null;

  if (form && feedbackSuccess && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.innerText = 'Submitting Triage Request...';

      setTimeout(() => {
        form.reset();
        submitBtn.classList.add('hidden');
        feedbackSuccess.classList.remove('hidden');
      }, 700);
    });
  }
</script>
